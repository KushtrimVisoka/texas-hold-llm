# Which backend answers agent turns: "ollama" (default) or "anthropic".
LLM_PROVIDER=ollama

# Ollama: any installed model with BOTH the `vision` and `tools` capabilities.
# Check with: ollama show <model> | grep -i capabilities
OLLAMA_BASE_URL=http://localhost:11434/v1
AGENT_MODEL=gemma4:latest

# Anthropic instead:
#   LLM_PROVIDER=anthropic
#   AGENT_MODEL=claude-sonnet-5
#   ANTHROPIC_API_KEY=sk-ant-...

# Per-decision patience. Defaults to 120s for ollama, 20s for anthropic.
# AGENT_TIMEOUT_MS=120000

# "off" sends the text state block only, with no screenshot.
VISION_MODE=on

DB_PATH=./data/poker.db
RENDER_DIR=./renders
